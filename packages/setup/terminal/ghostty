# ~/.config/ghostty/config — generated by scuttlarr; edit the overlay, not this file.
# Overlay: ~/.config/scuttlarr/ghostty is appended below, so its keys win.

# Colours come from the current theme (`theme set` renders it); `?` makes a
# missing file non-fatal, so a fresh install runs on Ghostty's own palette.
config-file = ?~/.local/state/scuttlarr/current/theme/ghostty

font-family = JetBrainsMono Nerd Font
font-size = 15

# De-shine
macos-titlebar-style = tabs
window-padding-x = 10
window-padding-y = 8
mouse-hide-while-typing = true
confirm-close-surface = always

# Shell integration on (cursor, jump-to-prompt, cwd for new tabs)
shell-integration = zsh
