# ~/.zshrc — generated by scuttlarr; edit the overlay, not this file.
#
#   base     @@BASE@@/shell/NN-*.zsh      (read-only, ships with the app)
#   overlay  @@OVERLAY@@/zsh/*.zsh         (yours; sourced after the base)
#   local    ~/.config/zsh/local.zsh       (this machine only, if present)
#
# `scuttlarr shell` shows what would change; `scuttlarr remove` puts the
# adopted original back.

# Powerlevel10k instant prompt. Must stay first: anything that prints before
# this defeats it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# The base, in numeric order.
for _sc_module in "@@BASE@@"/shell/[0-9][0-9]-*.zsh(N); do
  source "$_sc_module"
done

# The overlay, in sorted order.
for _sc_module in "@@OVERLAY@@"/zsh/*.zsh(N); do
  source "$_sc_module"
done
unset _sc_module

# Machine-local additions, managed by nobody.
if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/local.zsh" ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/local.zsh"
fi
